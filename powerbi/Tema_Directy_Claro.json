{
  "name": "Directy Claro",
  "dataColors": [
    "#23262D",
    "#C9A97A",
    "#7F8896",
    "#5BA67F",
    "#D05C5C",
    "#5B7BA6",
    "#B8B2A6",
    "#4F5563"
  ],
  "background": "#FFFFFF",
  "foreground": "#23262D",
  "tableAccent": "#C9A97A",
  "good": "#3E9B6A",
  "neutral": "#7F8896",
  "bad": "#D05C5C",
  "textClasses": {
    "callout": {
      "color": "#23262D",
      "fontFace": "Segoe UI Semibold"
    },
    "title": {
      "color": "#23262D",
      "fontFace": "Segoe UI Semibold"
    },
    "header": {
      "color": "#23262D",
      "fontFace": "Segoe UI Semibold"
    },
    "label": {
      "color": "#5F6673",
      "fontFace": "Segoe UI"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4E0D8"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 90,
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#23262D"
              }
            },
            "fontSize": 12
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F2EE"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E9E6E0"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#23262D"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#7F8896"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#23262D"
              }
            }
          }
        ],
        "values": [
          {
            "backColorSecondary": {
              "solid": {
                "color": "#F7F5F1"
              }
            }
          }
        ],
        "subTotals": [
          {
            "backColor": {
              "solid": {
                "color": "#EFEAE1"
              }
            }
          }
        ],
        "total": [
          {
            "backColor": {
              "solid": {
                "color": "#EFEAE1"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#23262D"
              }
            }
          }
        ],
        "values": [
          {
            "backColorSecondary": {
              "solid": {
                "color": "#F7F5F1"
              }
            }
          }
        ],
        "total": [
          {
            "backColor": {
              "solid": {
                "color": "#EFEAE1"
              }
            }
          }
        ]
      }
    }
  }
}